# Copy this file to .env and fill in the values. Never commit .env.

# ---------------------------------------------------------------- application
# Public URL of the app (used for report links and payment redirects)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Where the database, reports and baselines are stored
DATA_DIR=data

# web = website and API only, worker = scanner only, all = both in one process
ROLE=all
WORKER_CONCURRENCY=2

# Set to true behind a reverse proxy or load balancer (nginx, Render, Railway...)
TRUST_PROXY=false

# Set to false to stop new sign ups
SIGNUPS_OPEN=true

# Contact addresses shown in the product
SALES_EMAIL=sales@example.com
SUPPORT_EMAIL=support@example.com

# ---------------------------------------------------------------- security
# Allow scanning localhost and private network addresses.
# Defaults to true in development and false in production. Keep it false on any public server.
# ALLOW_PRIVATE_URLS=false

# Create demo accounts on start (development default: true, production default: false)
# SEED_DEMO_USERS=false

# ---------------------------------------------------------------- AI design review (optional)
# AI_API_KEY=
# AI_MODEL=

# ---------------------------------------------------------------- billing (optional)
# Leave empty to run without payments; plans can then be switched freely in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
