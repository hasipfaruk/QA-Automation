# Copy this file to .env and fill in the values.

# Public URL of the app (used for links in emails, reports and Stripe redirects)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Where the database, reports and baselines are stored
DATA_DIR=data

# web = only the website, worker = only the scanner, all = both in one process
ROLE=all
WORKER_CONCURRENCY=2

# Set to true when running behind a reverse proxy or load balancer (nginx, Render, Railway...)
TRUST_PROXY=false

# Allow scanning localhost and private network addresses.
# Defaults to true in development and false in production. Keep it false on a public server.
# ALLOW_PRIVATE_URLS=false

# Set to false to stop new sign ups
SIGNUPS_OPEN=true

# Optional: AI design review with Claude
# ANTHROPIC_API_KEY=

# Stripe billing (leave empty to run without payments; plans can then be switched freely in development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
